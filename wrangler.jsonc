{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photo-sharing",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,

  // The website (HTML, CSS, JS) lives in /public and is packed into the Worker before
  // every deploy and dev run. See scripts/build-site.mjs for why.
  "build": {
    "command": "node scripts/build-site.mjs",
    "watch_dir": "public"
  },

  // Photo files. The bucket "photos" already exists in the Cloudflare account.
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "photos" }
  ],

  // Albums, uploader, capture date, trash. Tables are created by the Worker itself.
  "d1_databases": [
    { "binding": "DB", "database_name": "photo-sharing-db", "database_id": "073e022b-6c63-45eb-9485-22fc482910d8" }
  ],

  // Once a day: empty trash older than 30 days, remove abandoned uploads.
  "triggers": { "crons": ["17 3 * * *"] },

  "vars": {
    // The name tiles on the start screen. Comma separated, in this order.
    "NAMES": "Niklas,Laurens,Andreas,Leon",
    "TRASH_DAYS": "30"
  }

  // The group password is a secret, not stored here.
  // Set it in the Cloudflare dashboard: Worker -> Settings -> Variables and Secrets
  // -> Add -> type "Secret", name APP_PASSWORD.
}
